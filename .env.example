# GEMINI_API_KEY: Required for Gemini AI analysis & screenshot OCR.
# Configure in AI Studio Secrets or server environment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL of the application.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional managed MongoDB connection string.
# If omitted, JOBSHIELD uses its local persistent SQLite store and reports MongoDB as Not Configured.
MONGODB_URI=""

# GOOGLE_CLIENT_ID: Optional Google OAuth 2.0 Web Client ID for Google Sign-In verification.
GOOGLE_CLIENT_ID=""

# WEB_RISK_API_KEY: Optional Google Cloud Web Risk API key for URL threat intelligence.
WEB_RISK_API_KEY=""

# ADMIN_BOOTSTRAP_PASSCODE: Optional server-side passcode to authorize initial Admin creation.
ADMIN_BOOTSTRAP_PASSCODE=""
